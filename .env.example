# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# Without these the server logs contact messages to the console instead of
# sending them, which is fine for development.

# Where contact messages are delivered.
CONTACT_TO=msametgok@hotmail.com

# Resend API key, from https://resend.com/api-keys. Mail goes out over HTTPS
# rather than SMTP: hosts commonly block outbound SMTP, and Render does, which
# left a deployed send hanging until the visitor gave up.
#
# If you already had SMTP_PASS set for the old transport, that same value is
# this key — Resend's SMTP password and API key are one credential.
RESEND_API_KEY=

# The address mail is sent as. Must be on a domain verified with Resend. It is
# never the visitor's address — that would be a spoof and would fail SPF, so it
# goes in reply_to instead.
MAIL_FROM=contact@msametgok.com

# Port for the API process.
PORT=3001
