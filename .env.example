# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# Without these the server logs contact messages to the console instead of
# sending them, which is fine for development.

# Where contact messages are delivered.
CONTACT_TO=msametgok@hotmail.com

# SMTP credentials for the mailbox that SENDS the mail.
#
# Use a transactional email provider (Resend, Brevo, Mailgun, Postmark) rather
# than your personal Hotmail account — Microsoft has been shutting off SMTP
# password auth for personal accounts, and mail sent from a provider is far less
# likely to land in spam. The provider sends; CONTACT_TO receives.
#
# For Resend, SMTP_USER is the literal word "resend" and SMTP_PASS is an API key.
# SMTP_FROM is the address mail is sent as, and must be on a domain you have
# verified with the provider — it is not the visitor's address, which goes in
# replyTo instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contact@msametgok.com

# Port for the API process.
PORT=3001
